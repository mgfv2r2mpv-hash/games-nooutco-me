ge\",\"urlLink\"],\"useSensitiveOnwardJourneys\":false,\"suitableForSyndication\":true,\"section\":{\"name\":\"Pablo\",\"uri\":\"/cbeebies/shows/pablo\"},\"translations\":{\"attribution\":\"Attribution\",\"audio\":\"Audio\",\"aroundTheBBC\":\"Around the BBC\",\"comments\":\"Comments\",\"externalLinksWarningText\":\"The BBC is not responsible for the content of external sites.\",\"game\":\"Game\",\"published\":\"Published\",\"relatedInternetLinks\":\"Related internet links\",\"seeAlsos\":\"More on this story\",\"tagList\":\"Related topics\",\"updated\":\"Updated\",\"video\":\"Video\",\"atAGlance\":\"At a glance\",\"quizDataCollectionMessage\":\"What information do we collect from this quiz?\",\"watchOnIPlayer\":\"Watch on iPlayer\",\"listenOnSounds\":\"Listen on Sounds\"}},\"content\":{\"model\":{\"blocks\":[{\"type\":\"childrensHeader\",\"model\":{\"headline\":\"Seven techniques for helping kids keep calm\",\"showAnimationSwitch\":false,\"animationSwitchTracking\":{\"experienceResourceId\":\"urn:bbc:isite:id:cbeebies.e7fa5a0a-2f1f-47bb-866c-9e7396086a3a\",\"groupName\":\"childrens header\",\"groupType\":\"article container\",\"entityName\":\"item\",\"itemType\":\"toggle\",\"itemName\":\"animation\",\"itemPosition\":2},\"showCommentsLink\":false}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try these simple relaxation and mindfulness activities together and help your child learn to calm down when they feel stressed or anxious.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try these simple relaxation and mindfulness activities together and help your child learn to calm down when they feel stressed or anxious.\",\"attributes\":[]}}]}}]}},{\"type\":\"image\",\"model\":{\"image\":{\"alt\":\"A young boy lying on the grass with his eyes closed looking happy.\",\"copyright\":null,\"height\":549,\"width\":976,\"src\":\"https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg.webp 976w\",\"mimeType\":\"image/webp\",\"fallbackSrcSets\":[{\"mimeType\":\"image/jpeg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/relaxation_for_kids_article_content_card.jpg 976w\"}],\"loading\":\"lazy\"}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Even very young children can feel stressed and anxious, especially during times of change or upheaval. Luckily, there are lots of simple activities you can do together to help your little one learn to calm themselves.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Even very young children can feel stressed and anxious, especially during times of change or upheaval. Luckily, there are lots of simple activities you can do together to help your little one learn to calm themselves.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Being able to recognise and cope with anxiety is a skill that will benefit children for life - try these simple, calming activities together and see which ones work for you.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Being able to recognise and cope with anxiety is a skill that will benefit children for life - try these simple, calming activities together and see which ones work for you.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"1. Use your mind…\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"1. Use your mind…\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"1-Use-your-mind\",\"isFocusable\":true}},{\"type\":\"media\",\"model\":{\"intentType\":\"animation\",\"orientation\":\"landscape\",\"media\":{\"__typename\":\"ElementsMediaPlayer\",\"items\":[{\"id\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/pablo_mindfulness_relaxation_fluff_cropped.gif\",\"idType\":\"href\",\"title\":\"\",\"duration\":0,\"holdingImageUrl\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/pablo_mindfulness_relaxation_fluff_cropped.gif\",\"kind\":\"programme\",\"isEmbeddingAllowed\":false,\"isAdvertisingAllowed\":false}],\"isToucanEnabled\":true,\"smpAppName\":\"cbeebies\",\"analytics\":{\"page\":{\"name\":\"cbeebies.joinin.seven_techniques_for_helping_kids_keep_calm.page\",\"destination\":\"CBEEBIES\",\"producer\":\"CBEEBIES\"}}}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Take a small food item (like a raisin or cracker) and ask your child to examine theirs closely (look at it, smell it, see what it feels like in their mouth, taste it and listen carefully to the sound it makes) as though they've never eaten one before.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Take a small food item (like a raisin or cracker) and ask your child to examine theirs closely (look at it, smell it, see what it feels like in their mouth, taste it and listen carefully to the sound it makes) as though they've never eaten one before.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Mindfulness is about being ‘in the moment’ and focusing completely on what you’re currently doing - using all your senses to really experience it. That might sound challenging for little ones, but simple mindfulness exercises can be a great way to help children learn to pause and think before reacting.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Mindfulness is about being ‘in the moment’ and focusing completely on what you’re currently doing - using all your senses to really experience it. That might sound challenging for little ones, but simple mindfulness exercises can be a great way to help children learn to pause and think before reacting.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"2. Have a giggle and a laugh\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"2. Have a giggle and a laugh\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"2-Have-a-giggle-and-a-laugh\",\"isFocusable\":true}},{\"type\":\"media\",\"model\":{\"intentType\":\"animation\",\"orientation\":\"landscape\",\"media\":{\"__typename\":\"ElementsMediaPlayer\",\"items\":[{\"id\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/justin_funny_mindfulness_cbeebies.gif\",\"idType\":\"href\",\"title\":\"\",\"duration\":0,\"holdingImageUrl\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/justin_funny_mindfulness_cbeebies.gif\",\"kind\":\"programme\",\"isEmbeddingAllowed\":false,\"isAdvertisingAllowed\":false}],\"isToucanEnabled\":true,\"smpAppName\":\"cbeebies\",\"analytics\":{\"page\":{\"name\":\"cbeebies.joinin.seven_techniques_for_helping_kids_keep_calm.page\",\"destination\":\"CBEEBIES\",\"producer\":\"CBEEBIES\"}}}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Watching a show your child loves, telling jokes or taking turns to pull funny faces at each other can be a great way to relax and handle nervousness.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Watching a show your child loves, telling jokes or taking turns to pull funny faces at each other can be a great way to relax and handle nervousness.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Laughter or feeling stimulated helps decrease stress hormones, and relaxes muscles.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Laughter or feeling stimulated helps decrease stress hormones, and relaxes muscles.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"id\":\"breathing-visualiser\",\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"3. Breathe deep…\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"3. Breathe deep…\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"isFocusable\":true}},{\"type\":\"media\",\"model\":{\"intentType\":\"animation\",\"orientation\":\"landscape\",\"media\":{\"__typename\":\"ElementsMediaPlayer\",\"items\":[{\"id\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/mindfulness_breathing_cbeebies.gif\",\"idType\":\"href\",\"title\":\"\",\"duration\":0,\"holdingImageUrl\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/mindfulness_breathing_cbeebies.gif\",\"kind\":\"programme\",\"isEmbeddingAllowed\":false,\"isAdvertisingAllowed\":false}],\"isToucanEnabled\":true,\"smpAppName\":\"cbeebies\",\"analytics\":{\"page\":{\"name\":\"cbeebies.joinin.seven_techniques_for_helping_kids_keep_calm.page\",\"destination\":\"CBEEBIES\",\"producer\":\"CBEEBIES\"}}}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Encourage your child to breathe in, hold and breathe out. You could use our visualiser as a guide - find a rate that feels comfortable for your little one. Keep going until they feel calmer.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Encourage your child to breathe in, hold and breathe out. You could use our visualiser as a guide - find a rate that feels comfortable for your little one. Keep going until they feel calmer.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Simply taking a series of deep breaths will slow down your little one’s heart rate, and help them feel more in control. \",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Simply taking a series of deep breaths will slow down your little one’s heart rate, and help them feel more in control. \",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"4. Stretch it out…\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"4. Stretch it out…\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"4-Stretch-it-out\",\"isFocusable\":true}},{\"type\":\"media\",\"model\":{\"intentType\":\"animation\",\"orientation\":\"landscape\",\"media\":{\"__typename\":\"ElementsMediaPlayer\",\"items\":[{\"id\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/mindfulness_stretching_cbeebies.gif\",\"idType\":\"href\",\"title\":\"\",\"duration\":0,\"holdingImageUrl\":\"https://childrens-binary.files.bbci.co.uk/childrens-binarystore/cbeebies/mindfulness_stretching_cbeebies.gif\",\"kind\":\"programme\",\"isEmbeddingAllowed\":false,\"isAdvertisingAllowed\":false}],\"isToucanEnabled\":true,\"smpAppName\":\"cbeebies\",\"analytics\":{\"page\":{\"name\":\"cbeebies.joinin.seven_techniques_for_helping_kids_keep_calm.page\",\"destination\":\"CBEEBIES\",\"producer\":\"CBEEBIES\"}}}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Stretch your arms above your heads, stand on tiptoes and make yourselves as tall as possible then flop back down, just like this.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Stretch your arms above your heads, stand on tiptoes and make yourselves as tall as possible then flop back down, just like this.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Encourage your little one to stretch out their muscles to reduce tension. Demonstrate how they could stretch out like a cat, or reach up to the sky.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Encourage your little one to stretch out their muscles to reduce tension. Demonstrate how they could stretch out like a cat, or reach up to the sky.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"5. Go cloud-spotting…\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"5. Go cloud-spotting…\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"5-Go-cloudspotting\",\"isFocusable\":true}},{\"type\":\"media\",\"model\":{\"orientation\":\"landscape\",\"media\":{\"__typename\":\"ElementsMediaPlayer\",\"items\":[{\"id\":\"p05fvxhs\",\"idType\":\"versionID\",\"title\":\"Mindfulness CBeebies Relaxation - Cloud Watching\",\"duration\":183,\"holdingImageUrl\":\"https://ichef.bbci.co.uk/images/ic/$recipe/p05fvy8m.jpg\",\"kind\":\"programme\",\"isEmbeddingAllowed\":true,\"isAdvertisingAllowed\":true}],\"isToucanEnabled\":true,\"smpAppName\":\"cbeebies\",\"externalEmbedUrl\":\"https://www.bbc.co.uk/news/av-embeds/content-seven-techniques-for-helping-kids-keep-calm/vpid/{vpid}\",\"pid\":\"p05fvxhq\",\"analytics\":{\"page\":{\"name\":\"cbeebies.joinin.seven_techniques_for_helping_kids_keep_calm.page\",\"destination\":\"CBEEBIES\",\"producer\":\"CBEEBIES\"}}}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Stay as still as you can and simply watch the clouds go by together. See if your little one can spot any shapes among the clouds. Use our visualiser if it's not practical to go outdoors - keep watching closely and you might even spot some familiar CBeebies characters.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Stay as still as you can and simply watch the clouds go by together. See if your little one can spot any shapes among the clouds. Use our visualiser if it's not practical to go outdoors - keep watching closely and you might even spot some familiar CBeebies characters.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"This common technique encourages your child to relax and take their mind off other things. You could do this alongside deep breathing to really help your child chill out.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"This common technique encourages your child to relax and take their mind off other things. You could do this alongside deep breathing to really help your child chill out.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"6. Relax with CBeebies Radio\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"6. Relax with CBeebies Radio\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"6-Relax-with-CBeebies-Radio\",\"isFocusable\":true}},{\"type\":\"image\",\"model\":{\"image\":{\"alt\":\"\",\"copyright\":null,\"height\":549,\"width\":976,\"src\":\"https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg.webp 976w\",\"mimeType\":\"image/webp\",\"fallbackSrcSets\":[{\"mimeType\":\"image/jpeg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebiesradio_calmingsoundsarticle_index_1920_1080.jpg 976w\"}],\"loading\":\"lazy\"}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Relax and listen to the calming sounds from CBeebies Radio.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Relax and listen to the \",\"attributes\":[]}},{\"type\":\"urlLink\",\"model\":{\"text\":\"calming sounds from CBeebies Radio.\",\"locator\":\"/cbeebies/curations/radio-calming-sounds\",\"isExternal\":false,\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"calming sounds from CBeebies Radio.\",\"attributes\":[]}}]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Listening to relaxing music can help children stop and reset. CBeebies Radio have eight calming sounds to choose from which allows you to experiment and find which one works best:\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Listening to relaxing music can help children stop and reset. CBeebies Radio have eight calming sounds to choose from which allows you to experiment and find which one works best:\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Waves, birdsong, rain, car journey, spaceship, white noise, pink noise and brown noise.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Waves, birdsong, rain, car journey, spaceship, white noise, pink noise and brown noise.\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Claire Benton, Head of Audiology, Nottingham, says:\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Claire Benton, Head of Audiology, Nottingham, says:\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"“Many children find these sounds relaxing and listening to them can help a child feel calm enough to fall asleep\\\".\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"“Many children find these sounds relaxing and listening to them can help a child feel calm enough to fall asleep\\\".\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"7. Do a doodle or colour in…\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"7. Do a doodle or colour in…\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"7-Do-a-doodle-or-colour-in\",\"isFocusable\":true}},{\"type\":\"image\",\"model\":{\"image\":{\"alt\":\"A dark purple background with a blue banner at the bottom. In the middle is a logo that reads \\\"CBeebies Creative Lab\\\" made from rainbow tape, dripping goo and glitter letters. Surrounding the logo are paint splats, rainbows and bubbles.\",\"copyright\":null,\"height\":549,\"width\":976,\"src\":\"https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg.webp 976w\",\"mimeType\":\"image/webp\",\"fallbackSrcSets\":[{\"mimeType\":\"image/jpeg\",\"srcSet\":\"https://ichef.bbci.co.uk/ace/standard/240/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 240w, https://ichef.bbci.co.uk/ace/standard/320/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 320w, https://ichef.bbci.co.uk/ace/standard/480/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 480w, https://ichef.bbci.co.uk/ace/standard/624/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 624w, https://ichef.bbci.co.uk/ace/standard/800/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 800w, https://ichef.bbci.co.uk/ace/standard/976/childrens/childrens-binarystore/cbeebies/cbeebies-creative-lab-index-image.jpg 976w\"}],\"loading\":\"lazy\"}}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Try it together\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Try it together\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Get busy with paper and crayons, or use CBeebies Creative Lab and doodle to your heart's content.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Get busy with paper and crayons, or use \",\"attributes\":[]}},{\"type\":\"urlLink\",\"model\":{\"text\":\"CBeebies Creative Lab\",\"locator\":\"/cbeebies/games/cbeebies-creative-lab\",\"isExternal\":false,\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"CBeebies Creative Lab\",\"attributes\":[]}}]}},{\"type\":\"fragment\",\"model\":{\"text\":\" and doodle to your heart's content.\",\"attributes\":[]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"How it works\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"How it works\",\"attributes\":[\"bold\"]}}]}},{\"type\":\"paragraph\",\"model\":{\"text\":\"Doodling can help relieve stress by giving your brain a rest, and it can also spark creativity. Pablo uses his doodles and subsequent trips to the Art World to solve the real-world issues thrown up by his autism.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Doodling can help relieve stress by giving your brain a rest, and it can also spark creativity. Pablo uses his doodles and subsequent trips to the Art World to solve the real-world issues thrown up by his autism.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Health and wellbeing\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Health and wellbeing\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"Health-and-wellbeing\",\"isFocusable\":true}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Find helpful tips and tricks to help children relax and be mindful of the world around them and helpful advice for parents and careers.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Find \",\"attributes\":[]}},{\"type\":\"urlLink\",\"model\":{\"text\":\"helpful tips and tricks to help children relax and be mindful\",\"locator\":\"/cbeebies/curations/mindfulness-for-children\",\"isExternal\":false,\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"helpful tips and tricks to help children relax and be mindful\",\"attributes\":[]}}]}},{\"type\":\"fragment\",\"model\":{\"text\":\" of the world around them and helpful advice for parents and careers.\",\"attributes\":[]}}]}}]}},{\"type\":\"subheadline\",\"model\":{\"blocks\":[{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Starting School with CBeebies\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Starting School with CBeebies\",\"attributes\":[]}}]}}]}}],\"level\":2,\"fontScale\":\"headlineSmall\",\"id\":\"Starting-School-with-CBeebies\",\"isFocusable\":true}},{\"type\":\"text\",\"model\":{\"blocks\":[{\"type\":\"paragraph\",\"model\":{\"text\":\"Are you looking for tips on handling primary school, new friends, homework and phonics? Find articles, activities, learning tips and much more in the CBeebies starting school collection.\",\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Are you looking for tips on handling primary school, new friends, homework and phonics? \",\"attributes\":[]}},{\"type\":\"urlLink\",\"model\":{\"text\":\"Find articles, activities, learning tips and much more in the CBeebies starting school collection\",\"locator\":\"/cbeebies/curations/starting-school-curation\",\"isExternal\":false,\"blocks\":[{\"type\":\"fragment\",\"model\":{\"text\":\"Find articles, activities, learning tips and much more in the CBeebies starting school collection\",\"attributes\":[]}}]}},{\"type\":\"fragment\",\"model\":{\"text\":\".\",\"attributes\":[]}}]}}]}},{\"type\":\"topicList\",\"model\":{\"heading\":\"Related topics\",\"topics\":[{\"service\":\"cbeebies\",\"title\":\"Pablo\",\"url\":\"/cbeebies/shows/pablo\"}],\"tracking\":{\"groupName\":\"iSite Related topics\"}}}]}},\"relatedUrls\":[],\"topics\":[{\"title\":\"Pablo\",\"url\":\"/cbeebies/shows/pablo\",\"isEvent\":false,\"id\":\"\"}]},\"importance\":\"PRIMARY\",\"isPersonalised\":false,\"hasFetcher\":true},\"onward-journeys?columnsByBreakpoint=%7B%22base%22%3A2%2C%22medium%22%3A3%2C%22large%22%3A1%7D&country=us&dataType=contentSummaries&enableDotcomAds=false&id=olderKidsGames&isUk=false&language=en-GB&limit=4&pageTypeIndicatorOverrides=%7B%22article%22%3A%7B%22iconType%22%3A%22content-types%3Aheadlines%22%7D%2C%22brand%22%3A%7B%22iconType%22%3A%22playback-avkx%3Aplay%22%2C%22altText%22%3A%22brand%22%7D%7D&sectionHeader=Games%20for%20older%20kids&service=cbeebies&showImage=true&tracking=%7B%22groupName%22%3A%22iSite%20Games%20for%20older%20kids%22%2C%22experiencePresentation%22%3A%22standard_two_column%22%2C%22experienceIsBreaking%22%3Afalse%7D&urn=urn%3Abbc%3Atipo%3Alist%3A92414d53-20e7-4ca1-a751-7d2678e15b84\":{\"name\":\"onward-journeys\",\"props\":{\"pageTypeIndicatorOverrides\":{\"article\":{\"iconType\":\"content-